def menu_prof(): #Menu principal do professor
    while True: #Mostrar opções
        print("Bem vindo!")
        print("1-Turmas")
        print("2-Alunos")
        print("3-Notas")
        print("4-Sair")
        opcao=int(input("Digite o número correspondente a opção desejada:"))
        while opcao != 1 and opcao != 2 and opcao != 3 and opcao !=4: #Pedir opções novamente caso necessário
            print("Opção inválida! Tente novamente")
            print("1-Turmas")
            print("2-Alunos")
            print("3-Notas")
            opcao=input("Digite o número correspondente a opção desejada:")
        #Rodar opções:
        if opcao == 1:
            print("Você escolheu a opção turmas")
            menu_prof_turma()
        elif opcao == 2:
            print("Você escolheu a opção alunos")
            menu_prof_alunos()
        elif opcao == 3:
            print("Você escolheu a opção notas")
            menu_prof_notas()
        else:
            print("Você escolheu sair!")
            break
